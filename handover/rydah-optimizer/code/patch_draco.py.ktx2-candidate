    cand['wardrobe/riders/caali-g.nonormal.glb']=['wardrobe/riders/caali-g.nonormal.ktx2.glb']   # default player; ?texfull=1 (caali-g.glb) stays unmapped on purpose
    cand['wardrobe/riders/caali-g-hd.glb']=['wardrobe/riders/caali-g-hd.ktx2.glb']   # WARDROBE_TIER 'hd' = default on desktop UAs (the gate's headless Chrome); Quest UA -> nonormal
    # Anika (Rydah Optimizer 2026-10-30): any default/hd/quest URL -> the 2.98 MB / 1.48 MB KTX2 tiers
    for w in ['rider','npc']:
        cand[f'anika/anika-{w}.draco-webp.glb']=[f'anika/anika-{w}.opt-ktx2.glb']   # roster default/hd/Quest URL; ?texfull=1 (anika-*.glb raw) stays unmapped like caali-g.glb
    cand['meshy/ikki-meshy-skate.quest-draco.glb']=['meshy/ikki-meshy-skate.s4-ktx2.glb']       # IKKI_URL default (?ikki=orig untouched)
    # NO WITHHELD_CHAR entries here: this table is inlined into index.html and the PUBLIC=1 package gate fails on any 'WITHHELD_CHAR' string.
    # audit guard (Optimizer 09:35): never map to the stale uncompressed/v1 copies
    for k,vs in cand.items():
        for v in vs: assert not v.endswith('.quest-ktx2.glb') and '.quest-ktx2.' not in v, ('stale ktx2 target', k, v)
