<script>/*SR_KTX2_GATE*//* patch_draco ktx2 candidate: ON when WARDROBE_TIER rule = quest (unless ?ktx2=0) or ?ktx2=1. Loads libs/ktx2/KTX2Loader.classic.js (r128 jsm, esbuild IIFE on window.THREE) + libs/basis/ (r128 transcoder) */
(function(){ window.SR_KTX2=(function(){ const P=new URLSearchParams(location.search), k=P.get('ktx2'), q=P.get('tier'); /* same rule as WARDROBE_TIER (defined later in the page, so mirrored here verbatim) */ const tier=(q==='hd'||q==='quest')?q:(/OculusBrowser|Quest|Android|iPhone|iPad/i.test(navigator.userAgent)?'quest':'hd'); return {on:k==='1'||(tier==='quest'&&k!=='0'), tier:tier}; })(); if(!window.SR_KTX2.on) return;
  document.write('<script src="libs/ktx2/KTX2Loader.classic.js"><\\/script>');
  window.SR_KTX2.map=%s; // default URL tail -> -ktx2 variant (only files that exist)
  window.SR_KTX2.url=function(u){ if(typeof u!=="string") return u; for(const k in window.SR_KTX2.map){ if(u.endsWith(k)) return u.slice(0,u.length-k.length)+window.SR_KTX2.map[k]; } return u; };
  function rdr(){ try{ return (typeof renderer!=="undefined"&&renderer)||window.renderer||null; }catch(e){ return window.renderer||null; } }
  window.SR_KTX2.loader=function(){ const S=window.SR_KTX2; if(S.k2) return S.k2; const r=rdr(); if(!THREE.KTX2Loader||!r) return null;
    S.k2=new THREE.KTX2Loader().setTranscoderPath("libs/basis/").detectSupport(r); return S.k2; };
  // renderer is created later in init(): defer each load until it exists (detectSupport needs it), then attach the shared KTX2Loader
  function wrapK(Orig){ if(!Orig||Orig.__srK2) return Orig;
    class SRK2GLTFLoader extends Orig{ load(url,onLoad,onProg,onErr){ const self=this, u=window.SR_KTX2.url(url);
