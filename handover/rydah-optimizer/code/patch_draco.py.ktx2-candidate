  const d=Object.getOwnPropertyDescriptor(THREE,"GLTFLoader"); let cur=wrapK(d&&d.get?d.get():THREE.GLTFLoader);
  Object.defineProperty(THREE,"GLTFLoader",{configurable:true,enumerable:true,get(){return cur;},set(v){ if(d&&d.set){ d.set(v); cur=wrapK(d.get()); } else cur=wrapK(v); }}); })();</script>''' % json.dumps(table)
    src=src.replace(anchor, anchor+gate)
    print("patch_draco(ktx2): gate installed; map entries:", len(table))
