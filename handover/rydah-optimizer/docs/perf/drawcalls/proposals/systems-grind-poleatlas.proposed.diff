+      .replace("#include <roughnessmap_fragment>","float roughnessFactor=mix(.92,.48,vPole);")
+      .replace("#include <metalnessmap_fragment>","float metalnessFactor=mix(0.,.75,vPole);"); };
+  mat.customProgramCacheKey=()=>"grindPolesAtlas";
+  const g=new THREE.CylinderGeometry(.85,1,1,10,1,true), P=new Float32Array(L.length); P.fill(1,W.length); g.setAttribute("aPole",new THREE.InstancedBufferAttribute(P,1));
+  const im=new THREE.InstancedMesh(g,mat,L.length), m=new THREE.Matrix4(), q=new THREE.Quaternion(), sc=new THREE.Vector3(), v=new THREE.Vector3();
