+// roughness and metalness, so each pole looks as before. Static, non-interactive: grind rails/splines (GRIND.S) untouched.
+function grindPolesBatched(W,G,M){ const L=W.concat(G); if(!L.length) return undefined;
+  const a=M.wood.map.image, b=M.galv.map.image, c=document.createElement("canvas"); c.width=a.width+b.width; c.height=Math.max(a.height,b.height);
