+  const mat=new THREE.MeshStandardMaterial({color:0xffffff,map:t,roughness:1,metalness:1});
+  mat.onBeforeCompile=s=>{
+    s.vertexShader="attribute float aPole;\nvarying float vPole;\n"+s.vertexShader.replace("#include <uv_vertex>","#include <uv_vertex>\n vPole=aPole;");
+    s.fragmentShader="varying float vPole;\n"+s.fragmentShader
