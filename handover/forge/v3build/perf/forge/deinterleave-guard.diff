# Guard so a future interleaved re-save of at-skate-meshy*.glb can't break the r128 merge (or silently mis-read in srSkateHalves).
+// r128 mergeBufferGeometries rejects InterleavedBufferAttribute: copy each into a tight BufferAttribute (keeps normalized flag)
+function srDeinterleave(g){ for(const k of Object.keys(g.attributes)){ const a=g.attributes[k]; if(!a.isInterleavedBufferAttribute) continue;
+  const n=a.count,s=a.itemSize,out=new a.array.constructor(n*s); for(let i=0;i<n;i++) for(let c=0;c<s;c++) out[i*s+c]=a.data.array[i*a.data.stride+a.offset+c];
+  g.setAttribute(k,new THREE.BufferAttribute(out,s,a.normalized)); } return g; }
 # srSkateSource():
-          const q=o.geometry.clone(), wh=/Wheel/.test(o.name), ...
+          const q=srDeinterleave(o.geometry.clone()), wh=/Wheel/.test(o.name), ...
 # srSkateHalves(): first line inside the traverse, before reading G.attributes.*:
